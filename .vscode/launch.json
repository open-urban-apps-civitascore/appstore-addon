{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Debug Server (pnpm dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --prefix app dev"
    },
    {
      "name": "Next.js: Debug Server Mock (pnpm dev:mock)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --prefix app dev:mock"
    },
    {
      "name": "Next.js: Attach to Node Process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
